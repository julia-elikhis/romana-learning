{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "database",
    "replicaCount",
    "appMode"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "appMode": {
      "type": "string",
      "enum": [
        "local",
        "public"
      ]
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "url",
            "parameters"
          ]
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "urlKey": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "usernameKey": {
          "type": "string",
          "minLength": 1
        },
        "passwordKey": {
          "type": "string",
          "minLength": 1
        },
        "sslMode": {
          "enum": [
            "disable",
            "allow",
            "prefer",
            "require",
            "verify-ca",
            "verify-full"
          ]
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "caKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "required": [
        "mode",
        "existingSecret",
        "name"
      ]
    },
    "service": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "Recreate",
            "RollingUpdate"
          ]
        }
      },
      "required": [
        "type"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "disabled",
            "filesystem",
            "gcs",
            "s3"
          ]
        },
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mountPath": {
              "type": "string",
              "pattern": "^/[^/].+"
            },
            "persistence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "existingClaim": {
                  "type": "string"
                },
                "create": {
                  "type": "boolean"
                },
                "size": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
                },
                "storageClass": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "accessModes": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "ReadWriteOnce",
                      "ReadWriteOncePod",
                      "ReadWriteMany"
                    ]
                  }
                },
                "keep": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "gcs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bucket": {
              "type": "string"
            },
            "prefix": {
              "type": "string"
            },
            "project": {
              "type": "string"
            },
            "credentialsSecret": {
              "type": "string"
            },
            "credentialsKey": {
              "type": "string",
              "minLength": 1
            },
            "settingsSecret": {
              "type": "string"
            },
            "workloadIdentity": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "provider",
                "credentialsSecret"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "provider": {
                  "type": "string",
                  "pattern": "^$|^projects/[0-9]+/locations/global/workloadIdentityPools/[a-z0-9-]+/providers/[a-z0-9-]+$"
                },
                "credentialsSecret": {
                  "type": "string"
                }
              }
            }
          }
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": {
              "type": "string"
            },
            "bucket": {
              "type": "string"
            },
            "prefix": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "accessKeyKey": {
              "type": "string"
            },
            "secretKeyKey": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "provider"
      ]
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        },
        "gcpServiceAccount": {
          "type": "string",
          "pattern": "^$|^[^@\\s]+@[^@\\s]+\\.iam\\.gserviceaccount\\.com$"
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "host": {
          "type": "string"
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "secretName": {
                "type": "string",
                "minLength": 1
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "secretName"
            ]
          }
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        }
      },
      "required": [
        "existingSecret"
      ]
    },
    "minio": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "global": {
      "type": "object"
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "baseURL": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "existingSecret",
        "baseURL"
      ]
    }
  },
  "additionalProperties": false
}
