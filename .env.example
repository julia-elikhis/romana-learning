# Copy to .env. Server-only secrets; never use VITE_ for credentials.
# Complete HTTPS endpoint URL for an OpenAI-compatible chat-completions API.
# A base URL ending in /v1 is also accepted; /chat/completions is appended.
# The URL may contain a secret token.
EXERCISE_API_URL=''
EXERCISE_API_KEY=''
# Model is required unless your endpoint selects one itself.
EXERCISE_API_MODEL=''
# Optional reasoning effort: none, minimal, low, medium, high, xhigh, max.
# Leave blank to use the provider default. Supported levels depend on the model.
EXERCISE_API_EFFORT=''
# Leave blank for standard reasoning_effort; use reasoning for gateways expecting
# the nested {"reasoning":{"effort":"..."}} request format.
EXERCISE_API_EFFORT_FORMAT=''

# GitHub OAuth app. Register this callback for local development:
# http://localhost:8080/auth/github/callback
GITHUB_CLIENT_ID=''
GITHUB_CLIENT_SECRET=''
APP_BASE_URL='http://localhost:8080'
# Optional: numeric GitHub account ID allowed to claim pre-login local data.
AUTH_LEGACY_GITHUB_ID=''
